{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "description": "Common configuration for all platforms",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "TRUE",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CPP_RTTI_ENABLED": "ON",
                "ozz_build_samples": "OFF",
                "ozz_build_howtos": "OFF",
                "ozz_build_tests": "OFF",
                "ozz_build_fbx": "OFF",
                "ASSIMP_BUILD_TESTS": "OFF",
                "ASSIMP_BUILD_ALL_IMPORTERS_BY_DEFAULT": "FALSE",
                "ASSIMP_BUILD_ALL_EXPORTERS_BY_DEFAULT": "FALSE",
                "ASSIMP_BUILD_DRACO": "TRUE",
                "ASSIMP_BUILD_DRACO_STATIC": "TRUE",
                "DRACO_GLTF": "TRUE",
                "DRACO_VERBOSE": "TRUE",
                "ASSIMP_BUILD_GLTF_IMPORTER": "TRUE",
                "ASSIMP_BUILD_SMD_IMPORTER": "TRUE",
                "ASSIMP_BUILD_SIB_IMPORTER": "TRUE",
                "ASSIMP_BUILD_OBJ_IMPORTER": "TRUE",
                "CMAKE_CXX_EXTENSIONS": "OFF"
            }
        },
        {
            "name": "dawn-common",
            "inherits": "common",
            "hidden": true,
            "description": "Common Dawn configuration for desktop platforms",
            "cacheVariables": {
                "DAWN_FETCH_DEPENDENCIES": "ON",
                "DAWN_ENABLE_D3D11": "OFF",
                "DAWN_ENABLE_D3D12": "OFF",
                "DAWN_ENABLE_METAL": "OFF",
                "DAWN_ENABLE_VULKAN": "OFF",
                "DAWN_BUILD_SAMPLES": "OFF",
                "DAWN_BUILD_TESTS": "OFF",
                "DAWN_BUILD_BENCHMARKS": "OFF",
                "DAWN_ENABLE_OPENGLES": "OFF",
                "DAWN_ENABLE_DESKTOP_GL": "OFF",
                "DAWN_BUILD_NODE_BINDINGS": "OFF",
                "DAWN_ENABLE_SWIFTSHADER": "OFF",
                "DAWN_BUILD_PROTOBUF": "OFF",
                "TINT_BUILD_TESTS": "OFF",
                "TINT_BUILD_TINTD": "OFF",
                "TINT_BUILD_CMD_TOOLS": "OFF",
                "TINT_BUILD_BENCHMARKS": "OFF",
                "TINT_BUILD_FUZZERS": "OFF",
                "TINT_BUILD_AS_OTHER_OS": "ON",
                "TINT_BUILD_MSL_WRITER": "OFF",
                "TINT_BUILD_IR_BINARY": "OFF",
                "TINT_ENABLE_INSTALL": "ON",
                "TINT_ENABLE_BREAK_IN_DEBUGGER": "OFF",
                "TINT_BUILD_WGSL_READER": "ON",
                "IMGUI_IMPL_WEBGPU_BACKEND_DAWN": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "linux-common",
            "inherits": "dawn-common",
            "hidden": true,
            "description": "Common configuration for Linux",
            "environment": {
                "RESOURCE_DIR": "${sourceDir}/Resources"
            },
            "cacheVariables": {
                "DAWN_ENABLE_VULKAN": "ON",
                "TINT_BUILD_SPV_WRITER": "ON",
                "USE_X11": "ON",
                "USE_VULKAN": "ON",
                "ASSIMP_BUILD_ZLIB": "ON"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "linux-common",
            "description": "Build with Dawn for Linux (Debug)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g",
                "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-rdynamic",
                "DAWN_BUILD_MONOLITHIC_LIBRARY": "OFF"
            }
        },
        {
            "name": "linux-release",
            "inherits": "linux-common",
            "description": "Build with Dawn for Linux (Release)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "osx-common",
            "inherits": "dawn-common",
            "hidden": true,
            "description": "Common configuration for macOS",
            "environment": {
                "RESOURCE_DIR": "${sourceDir}/Resources"
            },
            "cacheVariables": {
                "USE_METAL": "ON",
                "DAWN_ENABLE_METAL": "ON",
                "TINT_BUILD_MSL_WRITER": "ON",
                "ASSIMP_BUILD_MINIZIP": "ON"
            }
        },
        {
            "name": "osx-debug",
            "inherits": "osx-common",
            "description": "Build with Dawn for macOS (Debug)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "osx-release",
            "inherits": "osx-common",
            "description": "Build with Dawn for macOS (Release)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-vs2022-debug",
            "inherits": "dawn-common",
            "description": "Build with Dawn for Windows (VS 2022, Debug)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
                "USE_STATIC_MSVC_RUNTIME_LIBRARY": "OFF",
                "ozz_build_msvc_rt_dll": "ON",
                "DAWN_ENABLE_D3D12": "ON",
                "DAWN_FORCE_SYSTEM_COMPONENT_LOAD": "ON"
            }
        },
        {
            "name": "emscripten-common",
            "inherits": "common",
            "hidden": true,
            "description": "Common configuration for Emscripten",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "USE_GLFW": "3",
                "ASYNCIFY": "ON",
                "WASM_BIGINT": "ON",
                "ASSIMP_BUILD_ZLIB": "ON",
                "ALLOW_BLOCKING_ON_MAIN_THREAD": "1",
                "BUILD_SHARED_LIBS": "OFF",
                "ozz_build_tools": "OFF",
                "ozz_build_gltf": "OFF",
                "DEBUG_RENDERER_IN_DEBUG_AND_RELEASE": "OFF",
                "PROFILER_IN_DEBUG_AND_RELEASE": "OFF"
            }
        },
        {
            "name": "emscripten-debug",
            "inherits": "emscripten-common",
            "description": "Build for Emscripten (Debug)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "emscripten-release",
            "inherits": "emscripten-common",
            "description": "Build for Emscripten (Release)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
